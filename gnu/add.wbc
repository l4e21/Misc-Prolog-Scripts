% compiler: GNU Prolog 1.4.5
% file    : add.pl


file_name('/home/jam/prolog/Misc-Prolog-Scripts/gnu/add.pl').


predicate(add_two/3,3,static,private,monofile,global,1).


clause(:-(add_two(A,B,C),is(C,+(A,B))),[
    get_variable(x(3),1),
    put_structure((+)/2,1),
    unify_local_value(x(0)),
    unify_local_value(x(3)),
    put_value(x(2),0),
    execute((is)/2)]).


predicate(add_three/4,5,static,private,monofile,global,1).


clause(:-(add_three(A,B,C,D),is(D,+(+(A,B),C))),[
    put_structure((+)/2,4),
    unify_local_value(x(0)),
    unify_local_value(x(1)),
    put_structure((+)/2,1),
    unify_value(x(4)),
    unify_local_value(x(2)),
    put_value(x(3),0),
    execute((is)/2)]).


predicate(edge/2,8,static,private,monofile,global,3).


clause(edge(a,b),[
    get_atom(a,0),
    get_atom(b,1),
    proceed]).


clause(edge(b,c),[
    get_atom(b,0),
    get_atom(c,1),
    proceed]).


clause(edge(c,a),[
    get_atom(c,0),
    get_atom(a,1),
    proceed]).


predicate(path/3,12,static,private,monofile,global,2).


clause(:-(path(A,B,'.'(-(A,B),[])),edge(A,B)),[
    get_list(2),
    unify_variable(x(2)),
    unify_nil,
    get_structure((-)/2,2),
    unify_local_value(x(0)),
    unify_local_value(x(1)),
    execute((edge)/2)]).


clause(:-(path(A,B,'.'(-(A,C),D)),','(edge(A,C),path(C,B,D))),[
    allocate(3),
    get_variable(y(0),1),
    get_list(2),
    unify_variable(x(1)),
    unify_variable(y(2)),
    get_structure((-)/2,1),
    unify_local_value(x(0)),
    unify_variable(y(1)),
    put_value(y(1),1),
    call((edge)/2),
    put_value(y(1),0),
    put_value(y(0),1),
    put_value(y(2),2),
    deallocate,
    execute((path)/3)]).


predicate(more_than_3/1,15,static,private,monofile,global,1).


clause(:-(more_than_3(A),>(A,3)),[
    put_integer(3,1),
    execute((>)/2)]).


predicate(between/1,16,static,private,monofile,global,1).


clause(:-(between(A),','(more_than_3(A),<(A,6))),[
    allocate(1),
    get_variable(y(0),0),
    put_value(y(0),0),
    call((more_than_3)/1),
    put_value(y(0),0),
    put_integer(6,1),
    deallocate,
    execute((<)/2)]).
